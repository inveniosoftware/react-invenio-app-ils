/*******************************
Message Overrides - REACT-INVENIO-APP-ILS
*******************************/

.frontsite {
  .ui.message.document-stats-message {
    margin-top: 2em;
    margin-bottom: 2em;
    padding: 0;
  }
}

/* Rendered as a <span> inside the ESSelectorModal content <p> */
.ui.message.checkout-issues-message {
  display: block;

  span {
    display: block;
  }
}
